---
const paragraphs = [
  'I am a mechanical engineer who enjoys understanding the complete lifecycle of a product, not only how a component is designed, but how it is assembled, integrated, tested, maintained, and improved.',
  'My background is in precision mechanical design, where I worked through the full development process from requirements and concept development to detailed engineering, calculations, tolerance analysis, GD&T, design reviews, failure analysis, manufacturability, technical documentation, TPD, production support, and final release.',
  'While working as a designer, I also gained additional hands-on experience through weekend cleanroom assembly work. This helped me understand how released designs are physically handled, assembled, and experienced by technicians.',
  'I later moved into system qualification to experience the other side of engineering. I now work closer to operating machines, software-controlled system behaviour, test procedures, module failures, troubleshooting, repairs, verification, technical logging, shift handovers, and multidisciplinary cooperation.',
  'This was an intentional career move. I wanted to understand the practical details and system interactions that are difficult to experience fully from a mechanical-design role alone.',
  'Outside work, I enjoy hiking, learning unfamiliar technologies, and building personal projects involving mechanical design, RC systems, electronics, software, 3D printing, fabrication, and practical workshop tools.',
];

const collage = [
  { label: 'DESIGN', sub: 'CAD · drawing · render', accent: false },
  { label: 'BUILD', sub: 'printed part · assembly', accent: false },
  { label: 'TEST', sub: 'personal test setup', accent: false },
  { label: 'LEARN', sub: 'electronics · software', accent: false },
  { label: 'OUTSIDE', sub: 'hiking · personal', accent: true },
];
---

<section id="about" class="about">
  <div class="rule" aria-hidden="true"></div>
  <div class="inner">
    <div class="grid">
      <div data-reveal>
        <div class="kicker">01&nbsp;&nbsp;/&nbsp;&nbsp;ABOUT</div>
        <h2>Engineer at work.<br /><span class="italic">Builder after hours.</span></h2>
      </div>
      <div data-reveal class="copy">
        {paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>

    <div data-reveal class="collage">
      {collage.map((c, i) => (
        <div class={`tile ${i === 0 ? 'tall' : ''} ${c.accent ? 'accent' : ''}`}>
          <span class="tile-label">
            {c.label}
            <span class="tile-sub">{c.sub}</span>
          </span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: clamp(70px, 9vw, 140px) var(--page-pad);
  }

  .rule {
    position: absolute;
    left: var(--page-pad);
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-line);
  }

  .inner {
    padding-left: clamp(40px, 5vw, 72px);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(36px, 5vw, 72px);
    align-items: start;
  }

  @media (min-width: 820px) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    }
  }

  h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(34px, 4.4vw, 60px);
    line-height: 1.02;
    letter-spacing: -0.015em;
  }

  h2 .italic {
    font-style: italic;
    color: var(--color-accent);
  }

  .kicker {
    margin-bottom: 24px;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .copy p {
    font-size: clamp(16px, 1.15vw, 18px);
    line-height: 1.65;
    color: var(--color-ink-soft);
    text-wrap: pretty;
  }

  .collage {
    margin-top: clamp(40px, 5vw, 72px);
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-rows: 150px;
    gap: 16px;
  }

  @media (min-width: 540px) {
    .collage {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 820px) {
    .collage {
      grid-template-columns: 1.4fr 1fr 1fr;
      grid-auto-rows: 170px;
    }
  }

  .tile {
    position: relative;
    background: repeating-linear-gradient(135deg, #e7e4da, #e7e4da 9px, #eeece3 9px, #eeece3 18px);
    border: 1px solid var(--color-line-soft);
  }

  .tile.accent {
    background: repeating-linear-gradient(135deg, #dfe0d6, #dfe0d6 9px, #e7e8de 9px, #e7e8de 18px);
  }

  @media (min-width: 820px) {
    .tile.tall {
      grid-row: span 2;
    }
  }

  .tile-label {
    position: absolute;
    left: 14px;
    bottom: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }

  .tile.accent .tile-label {
    color: var(--color-accent);
  }

  .tile-sub {
    display: block;
    font-size: 9.5px;
    color: var(--color-faint);
    letter-spacing: 0.06em;
    margin-top: 3px;
  }
</style>
