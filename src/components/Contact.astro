---
---

<section id="contact" class="contact section-dark">
  <div class="inner">
    <div data-reveal class="content">
      <svg viewBox="0 0 120 40" class="squiggle" aria-hidden="true">
        <path data-path d="M6 20 C6 6 40 6 40 20 C40 34 74 34 74 20 C74 6 108 6 114 20" fill="none" stroke="#E2B93B" stroke-width="1.4"></path>
        <polygon points="114,20 106,16 106,24" fill="#E2B93B"></polygon>
      </svg>
      <div class="kicker">06&nbsp;&nbsp;/&nbsp;&nbsp;CONTACT</div>
      <h2>Let's build something worth testing.</h2>
      <p class="lead">
        For engineering opportunities, technical collaboration, or conversations about design, qualification, systems engineering, and product development, get in touch.
      </p>
      <div class="cta-row">
        <a href="mailto:hello@cameronbartholome.com" class="btn btn-gold">Email Cameron</a>
        <a href="#" target="_blank" rel="noopener" class="btn btn-outline">LinkedIn &#8599;</a>
        <a href="#contact" class="btn btn-outline">Request CV</a>
      </div>
    </div>
  </div>
  <div class="footer-bar">
    <div class="footer-inner">
      <span class="brand">Cameron B.</span>
      <span>Based in Eindhoven, Netherlands. &middot; CV available on request.</span>
      <button type="button" id="open-credits" class="credits-btn">Credits &amp; acknowledgements</button>
      <span>&copy; {new Date().getFullYear()}</span>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
  }

  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: clamp(80px, 10vw, 150px) var(--page-pad);
  }

  .content {
    max-width: 900px;
  }

  .squiggle {
    width: 120px;
    height: 40px;
    display: block;
    margin-bottom: 30px;
    overflow: visible;
  }

  .kicker {
    margin-bottom: 22px;
  }

  h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(36px, 5.2vw, 72px);
    line-height: 1;
    letter-spacing: -0.02em;
    margin-bottom: 26px;
  }

  .lead {
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.6;
    color: var(--color-dark-text-soft);
    max-width: 640px;
    margin-bottom: 40px;
    text-wrap: pretty;
  }

  .cta-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .cta-row .btn {
    padding: 16px 28px;
  }

  .footer-bar {
    border-top: 1px solid var(--color-dark-line);
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 28px var(--page-pad);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    color: var(--color-dark-text-mute);
  }

  .brand {
    font-family: var(--font-serif);
    font-size: 16px;
    letter-spacing: 0.02em;
    color: var(--color-dark-text);
  }

  .credits-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    color: var(--color-dark-text-mute);
    transition: color 0.2s;
  }

  .credits-btn:hover {
    color: var(--color-dark-text);
  }
</style>
