---
---

<section id="vorago" class="vorago">
  <div class="inner">
    <div data-reveal class="content">
      <div class="badge-row">
        <span class="eyebrow">INDEPENDENT PRODUCT WORK</span>
        <span class="coming-soon">COMING SOON</span>
      </div>
      <h2>Vorago Studio</h2>
      <p class="lead">
        A separate space for independent product development and selected finished work, combining design, prototyping, fabrication, and small-scale production. It is currently being built and will live at Vorago.studio once it is up and running.
      </p>
      <span class="pill">Vorago.studio &#8599;&nbsp;&nbsp;&middot;&nbsp;&nbsp;In development</span>
    </div>
  </div>
</section>

<style>
  .vorago {
    position: relative;
    background: #20221f;
    color: var(--color-dark-text);
  }

  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: clamp(56px, 7vw, 100px) var(--page-pad);
  }

  .content {
    max-width: 680px;
  }

  .badge-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    color: var(--color-dark-text-faint);
  }

  .coming-soon {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    color: var(--color-gold);
    border: 1px dashed rgba(226, 185, 59, 0.5);
    border-radius: 2px;
    padding: 4px 9px;
  }

  h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(30px, 3.6vw, 50px);
    line-height: 1.02;
    letter-spacing: 0.01em;
    margin-bottom: 16px;
  }

  .lead {
    font-size: clamp(15px, 1.15vw, 17px);
    line-height: 1.6;
    color: var(--color-dark-text-soft);
    text-wrap: pretty;
    margin-bottom: 26px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: var(--color-dark-text-faint);
    border: 1px solid var(--color-dark-line);
    padding: 14px 22px;
    border-radius: 2px;
  }
</style>
