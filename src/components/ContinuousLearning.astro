---
const cards = [
  {
    title: 'ENGINEERING & SYSTEMS',
    badge: 'CURRENT FOCUS',
    desc: 'Developing a broader understanding of complete systems, their behaviour and how they are tested and improved.',
    items: [
      'System qualification and machine behaviour',
      'Structured troubleshooting and root-cause analysis',
      'Requirements, verification and validation',
      'Systems engineering principles',
      'Safety-critical working methods',
      'Multidisciplinary technical communication',
    ],
  },
  {
    title: 'DATA & PROGRAMMING',
    badge: 'BUILDING',
    desc: 'Exploring how programming, data and software tools can support both technical work and personal projects.',
    items: [
      'Python fundamentals',
      'Engineering calculations and utilities',
      'Data analysis and visualisation',
      'Workflow automation',
      'Simulation and technical tools',
      'Excel-based utilities',
    ],
  },
  {
    title: 'BUSINESS & FINANCE',
    badge: 'EXPLORING',
    desc: 'Learning how businesses, markets and investments work so I can make better-informed financial decisions.',
    items: [
      'Corporate Finance Institute coursework',
      'Financial modelling',
      'Excel and business analysis',
      'Stock-market fundamentals',
      'Portfolio construction and diversification',
      'Risk and probability',
      'Investment decision-making',
      'Forecasting and comparing potential returns',
      'The Kelly criterion',
    ],
  },
];
---

<section id="learning" class="learning">
  <div class="rule" aria-hidden="true"></div>
  <div class="inner">
    <div data-reveal class="intro">
      <div class="kicker">04&nbsp;&nbsp;/&nbsp;&nbsp;CONTINUOUS LEARNING</div>
      <h2>Learning beyond the immediate role.</h2>
      <p class="tagline">Curiosity with a purpose.</p>
      <p class="lead">
        Engineering is my core discipline, but I also enjoy learning beyond it. My interests range from systems and programming to finance, investing and understanding how decisions are made across different industries.
      </p>
    </div>

    <div data-reveal class="grid">
      {cards.map((c) => (
        <div class="card">
          <div class="card-head">
            <div class="card-title">{c.title}</div>
            <span class="badge">{c.badge}</span>
          </div>
          <p class="card-desc">{c.desc}</p>
          <ul class="card-items">
            {c.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .learning {
    position: relative;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: clamp(60px, 7vw, 110px) var(--page-pad);
  }

  .rule {
    position: absolute;
    left: var(--page-pad);
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-line);
  }

  .inner {
    padding-left: clamp(40px, 5vw, 72px);
  }

  .intro {
    max-width: 760px;
    margin-bottom: clamp(34px, 4vw, 54px);
  }

  .intro .kicker {
    margin-bottom: 20px;
  }

  .intro h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(28px, 3.6vw, 48px);
    line-height: 1.04;
    letter-spacing: -0.015em;
    margin-bottom: 8px;
  }

  .tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(17px, 1.6vw, 22px);
    color: var(--color-accent);
    margin-bottom: 18px;
  }

  .lead {
    font-size: clamp(15px, 1.15vw, 17.5px);
    line-height: 1.62;
    color: var(--color-muted-2);
    max-width: 660px;
    text-wrap: pretty;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 960px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-line-soft);
    border-radius: 3px;
    padding: 24px 22px 26px;
    background: var(--color-bg-alt);
  }

  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .card-title {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    color: var(--color-muted-2);
    border: 1px solid var(--color-line);
    border-radius: 2px;
    padding: 3px 8px;
    white-space: nowrap;
  }

  .card-desc {
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-muted-2);
    margin-bottom: 16px;
    text-wrap: pretty;
  }

  .card-items {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
    line-height: 1.4;
    color: var(--color-ink-soft);
  }
</style>
