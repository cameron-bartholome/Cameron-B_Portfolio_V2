---
---

<header id="top" class="hero">
  <div data-reveal class="hero-copy">
    <div class="eyebrow">
      <span>Mechanical Design</span><span class="dot">&middot;</span><span>Hands-on Engineering</span><span class="dot">&middot;</span><span>System Qualification</span>
    </div>
    <h1>
      Designing the part.<br /><span class="italic">Understanding the system.</span>
    </h1>
    <p class="lead">
      Mechanical engineer with a strong background in precision mechanical design, currently broadening my experience through system qualification.
    </p>
    <p class="lead">
      My aim is to combine design depth with real-world system understanding and grow toward systems engineering and architecture.
    </p>
    <p class="lead lead-soft">
      Bridging design intent with real-world assembly, integration, testing, troubleshooting, and multidisciplinary problem-solving.
    </p>
    <p class="location">Based in Eindhoven, Netherlands.</p>
    <div class="cta-row">
      <a href="#process" class="btn btn-solid">Explore how I think &rarr;</a>
      <a href="#work" class="btn btn-outline">View selected work</a>
    </div>
  </div>

  <div data-reveal class="hero-figure">
    <div class="figure-frame">
      <svg viewBox="0 0 1040 780" class="route-svg" role="img" aria-label="A diagram showing career progression from foundation, through design and systems, to the current qualification stage, with an open path ahead">
        <rect x="18" y="18" width="1004" height="744" fill="none" stroke="rgba(26,28,27,.16)" stroke-width="1"></rect>
        <line x1="18" y1="672" x2="1022" y2="672" stroke="rgba(26,28,27,.16)" stroke-width="1"></line>

        <text x="46" y="60" font-size="23" fill="#747872" letter-spacing="4">FIG.01 &middot; THE ROUTE SO FAR</text>
        <text x="994" y="60" font-size="23" fill="#747872" letter-spacing="4" text-anchor="end">ELEVATION</text>

        <polyline points="150,600 300,430 382,472 470,300 545,205 622,322 690,272 772,360 882,300 1002,472" fill="none" stroke="#c3c1b6" stroke-width="1.1"></polyline>
        <polyline points="150,600 240,505 300,545 362,468" fill="none" stroke="#cbc9c0" stroke-width="1.1"></polyline>
        <polyline points="772,360 882,300 1010,505" fill="none" stroke="#cfcdc4" stroke-width="1.1"></polyline>
        <polyline points="382,472 545,318 712,472" fill="none" stroke="#bcbab0" stroke-width="1" stroke-dasharray="2 8"></polyline>
        <polyline points="414,542 545,402 680,542" fill="none" stroke="#c2c0b6" stroke-width="1" stroke-dasharray="2 8"></polyline>
        <polyline points="446,612 545,486 646,612" fill="none" stroke="#c8c6bc" stroke-width="1" stroke-dasharray="2 8"></polyline>
        <polyline points="780,470 882,362 990,470" fill="none" stroke="#c2c0b6" stroke-width="1" stroke-dasharray="2 8"></polyline>
        <polyline points="820,542 882,452 952,542" fill="none" stroke="#c8c6bc" stroke-width="1" stroke-dasharray="2 8"></polyline>

        <polyline points="720,286 815,238 902,190" fill="none" stroke="#1A1C1B" stroke-width="3.4" stroke-dasharray="2 13" stroke-linecap="round"></polyline>
        <polygon points="912,183 886,181 897,205" fill="#1A1C1B"></polygon>

        <polyline data-path points="185,560 360,470 450,442 560,362 660,320 720,286" fill="none" stroke="#1A1C1B" stroke-width="4.2" stroke-linejoin="round" stroke-linecap="round"></polyline>

        <g font-size="24" fill="#2f312e" letter-spacing="1.5">
          <circle cx="185" cy="560" r="6.5" fill="#1A1C1B"></circle>
          <line x1="185" y1="567" x2="185" y2="592" stroke="#1A1C1B" stroke-width="1"></line>
          <text x="150" y="614">FOUNDATION</text>

          <circle cx="360" cy="470" r="6.5" fill="#1A1C1B"></circle>
          <line x1="360" y1="463" x2="360" y2="438" stroke="#1A1C1B" stroke-width="1"></line>
          <text x="360" y="430" text-anchor="middle">DESIGN</text>

          <circle cx="720" cy="286" r="6.5" fill="#1A1C1B"></circle>
          <line x1="720" y1="279" x2="720" y2="246" stroke="#1A1C1B" stroke-width="1"></line>
          <text x="720" y="238" text-anchor="middle">SYSTEMS</text>

          <circle cx="815" cy="238" r="7.5" fill="#F1EFE7" stroke="#1A1C1B" stroke-width="1.6"></circle>
          <line x1="815" y1="230" x2="815" y2="198" stroke="#1A1C1B" stroke-width="1"></line>
          <text x="815" y="190" text-anchor="middle">OPEN PATH</text>
        </g>

        <g class="current-marker">
          <circle cx="560" cy="362" r="15" fill="none" stroke="#C75B32" stroke-width="2.2" class="pulse-ring"></circle>
          <circle cx="560" cy="362" r="6.5" fill="#C75B32"></circle>
          <path d="M560,378 L560,402 L592,402" fill="none" stroke="#C75B32" stroke-width="1.2"></path>
          <text x="602" y="409" font-size="25" fill="#C75B32" letter-spacing="1.5">QUALIFICATION</text>
          <text x="602" y="434" font-size="18" fill="#a3a6a1" letter-spacing="2">YOU ARE HERE</text>
        </g>

        <g font-size="24" letter-spacing="1.5">
          <line x1="95" y1="712" x2="955" y2="712" stroke="#1A1C1B" stroke-width="1.4"></line>
          <g stroke="#1A1C1B" stroke-width="1.4">
            <line x1="95" y1="705" x2="95" y2="719"></line>
            <line x1="310" y1="705" x2="310" y2="719"></line>
            <line x1="525" y1="705" x2="525" y2="719"></line>
            <line x1="740" y1="705" x2="740" y2="719"></line>
            <line x1="955" y1="705" x2="955" y2="719"></line>
          </g>
          <polygon points="944,690 966,690 955,707" fill="#C75B32"></polygon>
          <text x="95" y="748" fill="#2f312e" text-anchor="middle">CONCEPT</text>
          <text x="310" y="748" fill="#2f312e" text-anchor="middle">DESIGN</text>
          <text x="525" y="748" fill="#2f312e" text-anchor="middle">RELEASE</text>
          <text x="740" y="748" fill="#2f312e" text-anchor="middle">INTEGRATE</text>
          <text x="955" y="748" fill="#C75B32" text-anchor="middle">QUALIFY</text>
        </g>
      </svg>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: clamp(56px, 8vw, 110px) var(--page-pad) clamp(60px, 7vw, 100px);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
    scroll-margin-top: var(--nav-height);
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    }
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .eyebrow .dot {
    color: var(--color-accent);
  }

  h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(42px, 6.2vw, 84px);
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin-bottom: 30px;
  }

  h1 .italic {
    font-style: italic;
    color: var(--color-accent);
  }

  .lead {
    max-width: 490px;
    font-size: clamp(16px, 1.2vw, 18.5px);
    line-height: 1.6;
    color: var(--color-ink-soft);
    margin-bottom: 14px;
    text-wrap: pretty;
  }

  .lead-soft {
    font-size: clamp(15px, 1.1vw, 17px);
    color: var(--color-muted-2);
    margin-bottom: 18px;
  }

  .location {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    margin-bottom: 38px;
  }

  .cta-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero-figure {
    position: relative;
  }

  .figure-frame {
    position: relative;
    border: 1px solid var(--color-line);
    background: #f1efe7;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .route-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    font-family: var(--font-mono);
  }

  .pulse-ring {
    transform-box: fill-box;
    transform-origin: center;
    animation: pulseDot 2.6s ease-in-out infinite;
  }
</style>
